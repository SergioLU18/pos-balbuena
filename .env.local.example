# Copia este archivo a .env.local y ajusta los valores.

# Credenciales del proyecto Supabase (Project Settings → API). pos-balbuena comparte el
# MISMO proyecto que tali: son dos frontends del mismo restaurante sobre las mismas tablas
# (restaurantes/mesas/cuentas/cuenta_items), más las tablas propias del POS (meseros/pedidos).
# Corre en orden en el SQL Editor:
#   supabase/cleanup.sql  →  supabase/schema.sql  →  supabase/seed.sql
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
